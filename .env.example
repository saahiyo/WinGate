# Application
APP_NAME=User State Authorization API
ENVIRONMENT=development
DEBUG=false

# Database: SQLite for local use; PostgreSQL recommended in production
DATABASE_URL=sqlite:///./user_state.db

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Security and policy
MIN_PASSWORD_LENGTH=12
PAGE_STALE_SECONDS=120
GAME_HEARTBEAT_GRACE_SECONDS=90
GAME_SESSION_TTL_SECONDS=3600
ACTION_TOKEN_TTL_SECONDS=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# CORS: comma-separated origins. Never use * with credentials in production.
CORS_ORIGINS=http://localhost:3000

# Upstream Client Provider & Game Configuration
PROVIDER_API_URL=https://api.shreewinapi.com
PROVIDER_ORIGIN=https://shreewin39.com
GAME_BASE_URL=https://h5.ar-lottery01.com
